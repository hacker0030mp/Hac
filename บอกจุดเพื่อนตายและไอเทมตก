-- 💎 3. ระบบแสดงชื่อไอเทมที่ตกพื้น + บอกระยะทาง
-- ==========================================================
local activeItemGuis = {}

local function createItemMarker(itemObj)
    if not itemObj:IsA("BasePart") and not itemObj:IsA("Model") and not itemObj:IsA("Tool") then return end
    
    local targetPart = itemObj:IsA("BasePart") and itemObj or itemObj:FindFirstChildWhichIsA("BasePart")
    if not targetPart or targetPart:FindFirstChild("ItemMarkerGui") then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ItemMarkerGui"
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 215, 0) -- สีทองสำหรับไอเทม
    textLabel.TextStrokeTransparency = 0
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Parent = billboard

    billboard.Adornee = targetPart
    billboard.Parent = targetPart
    table.insert(activeItemGuis, billboard)

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not ItemTrackerEnabled or not itemObj or not itemObj.Parent or not targetPart then
            billboard:Destroy()
            connection:Disconnect()
            return
        end

        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude
            textLabel.Text = "💎 " .. itemObj.Name .. "\n[ " .. math.floor(dist) .. " เมตร ]"
        end
    end)
end

-- สแกนค้นหาไอเทมใน Workspace
local function scanItems()
    if not ItemTrackerEnabled then return end
    -- ค้นหาไอเทมที่อยู่ใน Folder แรร์/ของดรอป หรือใน Workspace ทั่วไป
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Tool") or v:IsA("Model") or (v:IsA("BasePart") and v.Name:lower():find("item")) or v:FindFirstChild("Handle") then
            if not Players:GetPlayerFromCharacter(v) then -- เช็คว่าไม่ใช่ตัวละครของผู้เล่น
                createItemMarker(v)
            end
        end
    end
end

workspace.ChildAdded:Connect(function(child)
    if ItemTrackerEnabled then
        task.wait(0.2)
        if child:IsA("Tool") or child:IsA("Model") or child:FindFirstChild("Handle") then
            if not Players:GetPlayerFromCharacter(child) then
                createItemMarker(child)
            end
        end
    end
end)

