-- ปุ่มใช้งานหลัก (สีเขียว)
MainSection:Button({
    Title = "🟢 ใช้งานสคริปต์",
    Callback = function()
        if inputScriptName ~= "" and inputScriptCode ~= "" then
            scriptCounter = scriptCounter + 1
            local currentId = scriptCounter
            local savedName = inputScriptName
            local savedCode = inputScriptCode
            
            local success, err = pcall(function()
                loadstring(savedCode)()
            end)
            
            if success then
                WindUI:Notify({ Title = "สำเร็จ", Content = "รันสคริปต์ " .. savedName .. " สำเร็จ!", Duration = 3 })
                
                -- เพิ่มปุ่มในหมวดหมู่บันทึกพร้อมเลขอ้างอิง
                SavedSection:Button({
                    Title = "📁 " .. savedName .. " #" .. currentId,
                    Callback = function()
                        pcall(function() loadstring(savedCode)() end)
                        WindUI:Notify({ Title = "โหลดสคริปต์", Content = "กำลังรัน: " .. savedName .. " (#" .. currentId .. ")", Duration = 2 })
                    end
                })
                
                -- บันทึกลงประวัติ
                local currentTime = os.date("%H:%M:%S - %d/%m/%Y")
                HistorySection:Paragraph({
                    Title = "[#" .. currentId .. "] " .. savedName .." (".. currentTime ..")",
                    Content = "สถานะ: สำเร็จ [🟢]\nโค้ด:\n" .. savedCode
                })
            else
                WindUI:Notify({ Title = "ข้อผิดพลาด", Content = "รันสคริปต์ไม่สำเร็จ: " .. tostring(err), Duration = 4 })
            end
        else
            WindUI:Notify({ Title = "แจ้งเตือน", Content = "กรุณากรอกชื่อและโค้ดสคริปต์ให้ครบถ้วน", Duration = 2 })
        end
    end
})

