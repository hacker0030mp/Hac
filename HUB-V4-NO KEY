local HttpService = game:GetService("HttpService")

-- โครงสร้างตารางเก็บข้อมูลที่จะบันทึก
local SaveFileName = "MinhKhaHub_Config.json"
local ConfigData = {
    SavedInputText = "",
    AutoSaveEnabled = true,
}

-- 1. ฟังก์ชันโหลดข้อมูลที่เคยบันทึกไว้
local function LoadConfig()
    if isfile and isfile(SaveFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SaveFileName))
        end)
        if success and type(result) == "table" then
            for key, value in pairs(result) do
                ConfigData[key] = value
            end
            print("[Minh Kha Hub] Load config successfully!")
        end
    end
end

-- 2. ฟังก์ชันบันทึกข้อมูลลงไฟล์
local function SaveConfig()
    if writefile then
        local success, err = pcall(function()
            writefile(SaveFileName, HttpService:JSONEncode(ConfigData))
        end)
        if success then
            print("[Minh Kha Hub] Auto Saved Config!")
        else
            warn("[Minh Kha Hub] Save failed: " .. tostring(err))
        end
    end
end

-- โหลดข้อมูลตั้งต้นก่อนสร้าง UI
LoadConfig()

