local DeltaScriptHub = {
    Editor = {
        ScriptBuffer1 = "",
        ScriptBuffer2 = "",
        ScriptBuffer3 = "",
        
        SetScript1 = function(self, codeText) self.ScriptBuffer1 = codeText or "" end,
        SetScript2 = function(self, codeText) self.ScriptBuffer2 = codeText or "" end,
        SetScript3 = function(self, codeText) self.ScriptBuffer3 = codeText or "" end,
        
        RunScript = function(self, target)
            local code = (target == 1 and self.ScriptBuffer1) or (target == 2 and self.ScriptBuffer2) or self.ScriptBuffer3
            if code == "" then
                return warn("[SYSTEM ERROR]: กรุณาใส่ Script ก่อนทำการรันช่องที่ " .. target)
            end
            local func, err = loadstring(code)
            if not func then
                return warn("[SYSTEM ERROR] Syntax Error (" .. target .. "): " .. tostring(err))
            end
            local success, runErr = pcall(func)
            if not success then
                warn("[SYSTEM ERROR] Execution Error (" .. target .. "): " .. tostring(runErr))
            else
                print("[Editor] รัน Script ช่องที่ " .. target .. " สำเร็จ")
            end
        end,

        AutoRunScript = function(self, enable)
            if enable then
                if writefile then writefile("DeltaAutoRun.lua", self.ScriptBuffer1) end
                print("[Editor] เปิดใช้งาน AutoRun เรียบร้อย")
            else
                if isfile and delfile and isfile("DeltaAutoRun.lua") then
                    delfile("DeltaAutoRun.lua")
                end
                print("[Editor] ปิดการใช้งาน AutoRun แล้ว")
            end
        end
    }
}

