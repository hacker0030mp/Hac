-- Delta Script Hub - Real AutoRun (Fast Loop / Spam Run)
-- ========================================================

local DeltaScriptHub = {
    Editor = {
        ScriptBuffer1 = "",
        ScriptBuffer2 = "",
        ScriptBuffer3 = "",
        AutoRunActive = false,
        AutoRunThread = nil,
        
        SetScript1 = function(self, codeText) self.ScriptBuffer1 = codeText or "" end,
        SetScript2 = function(self, codeText) self.ScriptBuffer2 = codeText or "" end,
        SetScript3 = function(self, codeText) self.ScriptBuffer3 = codeText or "" end,
        
        RunScript = function(self, target)
            local code = (target == 1 and self.ScriptBuffer1) or (target == 2 and self.ScriptBuffer2) or self.ScriptBuffer3
            if code == "" then
                return warn("[SYSTEM ERROR]: กรุณาใส่ Script ช่องที่ " .. target)
            end
            local func, err = loadstring(code)
            if not func then
                return warn("[SYSTEM ERROR] Syntax Error (" .. target .. "): " .. tostring(err))
            end
            local success, runErr = pcall(func)
            if not success then
                warn("[SYSTEM ERROR] Execution Error (" .. target .. "): " .. tostring(runErr))
            else
                print("[Editor] รัน Script ช่องที่ " .. target .. " สำเร็จ")
            end
        end,

        -- ระบบ AutoRun แบบรันรัวๆ / วนลูปทำงานจริง
        AutoRunScript = function(self, enable)
            self.AutoRunActive = enable
            
            if enable then
                if self.AutoRunThread then
                    task.cancel(self.AutoRunThread)
                end
                
                -- สร้างเธรดรันสคริปต์ช่องที่ 1 วนซ้ำแบบรัวๆ
                self.AutoRunThread = task.spawn(function()
                    print("[Editor] เริ่มต้นระบบ AutoRun (รันรัวๆ)...")
                    while self.AutoRunActive do
                        if self.ScriptBuffer1 ~= "" then
                            local func, err = loadstring(self.ScriptBuffer1)
                            if func then
                                pcall(func)
                            end
                        end
                        -- ดีเลย์เล็กน้อย (เช่น 0.05 หรือ 0.1 วินาทีต่อรอบ) เพื่อไม่ให้เกมค้างหรือกระตุกจนเกินไป
                        task.wait(0.1) 
                    end
                    print("[Editor] หยุดการทำงานระบบ AutoRun แล้ว")
                end)
            else
                if self.AutoRunThread then
                    task.cancel(self.AutoRunThread)
                    self.AutoRunThread = nil
                end
                print("[Editor] ปิดการใช้งาน AutoRun เรียบร้อย")
            end
        end
    }
}

