-- 5. TAB: ESP & Teleport (ESP สำหรับ Player และ Monster พร้อมชื่อ ชนิด ระยะทาง)
-- =========================================================================
local ESPSect = TabESP:Section({ Title = "ระบบมองทะลุขั้นสูง (Player & Monster ESP)", Box = true, Opened = true })

local ESPState = { Enabled = false, Box = true, Tracer = true, Info = true }
local ESPDraws = {}

local function ClearESP(obj)
    if ESPDraws[obj] then
        pcall(function()
            for _, o in pairs(ESPDraws[obj]) do
                if o and typeof(o.Remove) == "function" then o:Remove() end
            end
        end)
        ESPDraws[obj] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not ESPState.Enabled then
        for obj in pairs(ESPDraws) do ClearESP(obj) end
        return
    end

    pcall(function()
        local targets = {}

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                table.insert(targets, {Instance = p.Character, Name = p.Name, Type = "Player", Color = Color3.fromRGB(59, 130, 246)})
            end
        end

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
                local isPlayerChar = Players:GetPlayerFromCharacter(v)
                if not isPlayerChar and v ~= LocalPlayer.Character then
                    table.insert(targets, {Instance = v, Name = v.Name, Type = "Monster", Color = Color3.fromRGB(239, 68, 68)})
                end
            end
        end

        for _, target in ipairs(targets) do
            local char = target.Instance
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")

            if not hrp or not hum or hum.Health <= 0 then
                ClearESP(char)
                continue
            end

            if not ESPDraws[char] and Drawing then
                ESPDraws[char] = {
                    Box = Drawing.new("Square"),
                    Line = Drawing.new("Line"),
                    Text = Drawing.new("Text")
                }
                ESPDraws[char].Box.Thickness = 1.5; ESPDraws[char].Box.Filled = false
                ESPDraws[char].Line.Thickness = 1
                ESPDraws[char].Text.Size = 13; ESPDraws[char].Text.Center = true; ESPDraws[char].Text.Outline = true; ESPDraws[char].Text.Color = Color3.new(1, 1, 1)
            end

            local draws = ESPDraws[char]
            if draws then
                local vPos, onScr = Camera:WorldToViewportPoint(hrp.Position)
                local head = char:FindFirstChild("Head")
                local tV = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vPos
                local bV = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                local h = math.abs(tV.Y - bV.Y)
                local w = h / 2

                draws.Box.Visible = onScr and ESPState.Box
                draws.Box.Color = target.Color
                draws.Line.Visible = onScr and ESPState.Tracer
                draws.Line.Color = target.Color
                draws.Text.Visible = onScr and ESPState.Info

                if onScr then
                    if ESPState.Box then
                        draws.Box.Size = Vector2.new(w, h)
                        draws.Box.Position = Vector2.new(vPos.X - w / 2, tV.Y)
                    end
                    if ESPState.Tracer then
                        local vp = Camera.ViewportSize
                        draws.Line.From = Vector2.new(vp.X / 2, vp.Y)
                        draws.Line.To = Vector2.new(vPos.X, bV.Y)
                    end
                    if ESPState.Info then
                        local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                        draws.Text.Text = "[" .. target.Type .. "] " .. target.Name .. " (" .. dist .. "m)"
                        draws.Text.Position = Vector2.new(vPos.X, tV.Y - 18)
                    end
                end
            end
        end
    end)
end)

