local function CreateButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(24, 32, 47)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Parent = ContentContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(callback)
end

-- ฟังก์ชันกลางสำหรับโหลดสคริปต์ทีละตัวแยกอิสระ
local function RunSingleScript(url, scriptName)
    task.spawn(function()
        local ok, code = pcall(function() return game:HttpGet(url) end)
        if ok and code and #code > 0 then
            local fn, loadErr = loadstring(code)
            if fn then
                local runOk, runErr = pcall(fn)
                if runOk then
                    print("✅ รัน " .. scriptName .. " สำเร็จ!")
                else
                    warn("⚠️ ข้อผิดพลาดในการรัน " .. scriptName .. ": " .. tostring(runErr))
                end
            else
                warn("⚠️ รูปแบบโค้ด " .. scriptName .. " ไม่ถูกต้อง: " .. tostring(loadErr))
            end
        else
            warn("⚠️ ไม่สามารถเชื่อมต่อลิงก์ของ " .. scriptName .. " ได้")
        end
    end)
end

