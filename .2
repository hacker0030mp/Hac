local AdminSec = TabAdmin:Section({ Title = "Script Executor Console", Box = true, Opened = true })

local inputScriptName = ""
local inputScriptCode = ""

AdminSec:Input({
    Title = "ชื่อสคริปต์",
    Placeholder = "พิมพ์ชื่อที่นี่...",
    Callback = function(t) inputScriptName = t end
})

AdminSec:Input({
    Title = "โค้ดสคริปต์ (Loadstring)",
    Placeholder = "loadstring(game:HttpGet('...'))()",
    Callback = function(t) inputScriptCode = t end
})

AdminSec:Button({
    Title = "🟢 รันสคริปต์",
    Callback = function()
        if inputScriptCode == "" then
            WindUI:Notify({ Title = "⚠️ แจ้งเตือน", Content = "กรุณากรอกโค้ดก่อนกดรัน", Duration = 2 })
            return
        end
        local fn, err = loadstring(inputScriptCode)
        if fn then
            local ok, runErr = pcall(fn)
            if ok then
                WindUI:Notify({ Title = "✅ สำเร็จ", Content = "รันสคริปต์สำเร็จเรียบร้อย!", Duration = 3 })
            else
                WindUI:Notify({ Title = "❌ ผิดพลาด", Content = tostring(runErr), Duration = 4 })
            end
        else
            WindUI:Notify({ Title = "❌ โค้ดผิดพลาด", Content = tostring(err), Duration = 4 })
        end
    end
})

