-- =========================================================================
-- ⚙️ ระบบภายใน (Systems & Logic) ที่ดึงมาทำงานร่วมด้วย
-- =========================================================================
local ContentContainer = Instance.new("ScrollingFrame")
ContentContainer.Size = UDim2.new(1, -20, 1, -60)
ContentContainer.Position = UDim2.new(0, 10, 0, 50)
ContentContainer.BackgroundTransparency = 1
ContentContainer.BorderSizePixel = 0
ContentContainer.CanvasSize = UDim2.new(0, 0, 0, 400)
ContentContainer.ScrollBarThickness = 4
ContentContainer.Parent = MainFrame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 10)
UIListLayout.Parent = ContentContainer

-- ฟังก์ชันสร้างปุ่มสไตล์โมเดิร์นในหน้าต่างเราเอง
local function CreateButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(30, 41, 59)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Parent = ContentContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(callback)
end

-- เพิ่มระบบฟังก์ชันตัวอย่าง (เช่น วาร์ป / รีเซ็ต / เร่งสปีด)
CreateButton("⚡ เร่งความเร็วเดิน (WalkSpeed = 50)", function()
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 50
        end
    end)
end)

CreateButton("📍 รีเซ็ตตำแหน่งขึ้นฟ้าเล็กน้อย", function()
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 10, 0)
        end
    end)
end)

CreateButton("❌ ปิดการทำงานทั้งหมด", function()
    ScreenGui:Destroy()
end)
