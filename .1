-- =========================================================================
-- 🛡️ ระบบการจัดการความเสถียรและการเรียกใช้งานสคริปต์ (Execution Engine)
-- =========================================================================
local HubManager = {}

function HubManager:SafeExecute(name, func)
    local ok, err = pcall(func)
    if not ok then
        warn("⚠️ [RTS HUB Error in " .. tostring(name) .. "]: " .. tostring(err))
        pcall(function()
            WindUI:Notify({
                Title = "⚠️ แจ้งเตือนข้อผิดพลาด",
                Content = "จุดที่เกิดปัญหา: " .. tostring(name),
                Duration = 3
            })
        end)
    end
end

