-- =========================================================================
-- ระบบเป้าเล็งรูปบวกหมุนได้ (Crosshair System)
-- =========================================================================
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local CrosshairSettings = {
    Enabled = false,
    Color = Color3.fromRGB(255, 255, 255),
    Radius = 45,
    Size = 12,
    Thickness = 2,
    RotationSpeed = 3
}

local crosshairLines = {}
for i = 1, 4 do
    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = CrosshairSettings.Color
    line.Thickness = CrosshairSettings.Thickness
    line.Transparency = 1
    table.insert(crosshairLines, line)
end

local circle = Drawing.new("Circle")
circle.Visible = false
circle.Color = CrosshairSettings.Color
circle.Thickness = 1.5
circle.NumSides = 32
circle.Radius = CrosshairSettings.Radius
circle.Filled = false
circle.Transparency = 1

local currentAngle = 0

RunService.RenderStepped:Connect(function(dt)
    if not CrosshairSettings.Enabled then
        for _, line in ipairs(crosshairLines) do line.Visible = false end
        circle.Visible = false
        return
    end

    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    circle.Visible = true
    circle.Position = center
    circle.Radius = CrosshairSettings.Radius
    circle.Color = CrosshairSettings.Color

    currentAngle = currentAngle + (CrosshairSettings.RotationSpeed * dt)

    for i = 1, 4 do
        local line = crosshairLines[i]
        line.Visible = true
        line.Color = CrosshairSettings.Color
        line.Thickness = CrosshairSettings.Thickness

        local angle = currentAngle + ((i - 1) * (math.pi / 2))
        local innerDist = 4
        local outerDist = innerDist + CrosshairSettings.Size

        local p1 = Vector2.new(center.X + math.cos(angle) * innerDist, center.Y + math.sin(angle) * innerDist)
        local p2 = Vector2.new(center.X + math.cos(angle) * outerDist, center.Y + math.sin(angle) * outerDist)

        line.From = p1
        line.To = p2
    end
end)

SettingsSection:Toggle({
    Title = "เปิด/ปิด เป้าเล็งบวกหมุนได้",
    Callback = function(state)
        CrosshairSettings.Enabled = state
        WindUI:Notify({ Title = "Crosshair", Content = state and "เปิดเป้าเล็งแล้ว" or "ปิดเป้าเล็งแล้ว", Duration = 2 })
    end
})

-- =========================================================================
-- ระบบ AimLock (ล็อคเป้าผู้เล่นใกล้สุดในระยะมองเห็น)
-- =========================================================================
local AimSettings = {
    Enabled = false,
    FOV = 150,
    TeamCheck = true
}

local function getClosestPlayerInFOV()
    local closestPlayer = nil
    local shortestDistance = AimSettings.FOV
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local isSameTeam = false
                if AimSettings.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                    isSameTeam = true
                end

                if not isSameTeam then
                    local hrp = player.Character.HumanoidRootPart
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen then
                        local screenCoord = Vector2.new(screenPos.X, screenPos.Y)
                        local distance = (screenCoord - viewportCenter).Magnitude

                        if distance < shortestDistance then
                            shortestDistance = distance
                            closestPlayer = player.Character.HumanoidRootPart
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    if not AimSettings.Enabled then return end
    local targetPart = getClosestPlayerInFOV()
    if targetPart then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
    end
end)

SettingsSection:Toggle({
    Title = "เปิด/ปิด ล็อคเป้าผู้เล่นใกล้สุด (AimLock)",
    Callback = function(state)
        AimSettings.Enabled = state
        WindUI:Notify({ Title = "AimLock", Content = state and "เปิดระบบล็อคเป้าแล้ว" or "ปิดระบบล็อคเป้าแล้ว", Duration = 2 })
    end
})

-- =========================================================================
-- ระบบแสดงผล FPS และ Ping ด้านบนหน้าจอ (Tags)
-- =========================================================================
local FPSTag = Window:Tag({
    Title = "FPS: 0",
    Color = Color3.fromRGB(100, 150, 255),
})

local lastUpdate = tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    
    if now - lastUpdate >= 1 then
        local fps = math.floor(frameCount / (now - lastUpdate))
        FPSTag:SetTitle("FPS: " .. fps)
        
        if fps >= 50 then
            FPSTag:SetColor(Color3.fromRGB(0, 255, 0))
        elseif fps >= 30 then
            FPSTag:SetColor(Color3.fromRGB(255, 200, 0))
        else
            FPSTag:SetColor(Color3.fromRGB(255, 0, 0))
        end
        
        frameCount = 0
        lastUpdate = now
    end
end)

local PingTag = Window:Tag({
    Title = "Ping: 0ms",
    Color = Color3.fromRGB(100, 200, 255),
})

task.spawn(function()
    while true do
        local success, ping = pcall(function()
            local Stats = game:GetService("Stats")
            local pingValue = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
            return math.floor(pingValue)
        end)
        
        if success and ping then
            PingTag:SetTitle("Ping: " .. ping .. "ms")
            
            if ping <= 50 then
                PingTag:SetColor(Color3.fromRGB(0, 255, 0))
            elseif ping <= 100 then
                PingTag:SetColor(Color3.fromRGB(255, 200, 0))
            elseif ping <= 200 then
                PingTag:SetColor(Color3.fromRGB(255, 150, 0))
            else
                PingTag:SetColor(Color3.fromRGB(255, 0, 0))
            end
        end
        
        task.wait(2)
    end
end)

