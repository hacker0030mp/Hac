local _version = "1.6.66"
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/" .. _version .. "/main.lua"))() 

local Window = WindUI:CreateWindow({
    Title = "Minh Kha Hub • [+1 Loot To Forge]",
    Icon = "flame",
    Author = "Modular Github Integration",
})

-- สร้าง Tabs เรียกใช้ฟังก์ชันจากไฟล์ที่ดึงมาจาก GitHub
local MainTab = Window:Tab({ Title = "Main FX", Icon = "flame" })
local RaceTab = Window:Tab({ Title = "Race", Icon = "dna" })
local TrackerTab = Window:Tab({ Title = "Trackers", Icon = "radar" })

-- สวิตช์/ปุ่มกดเรียกใช้ฟังก์ชันจากโมดูลที่โหลดมา
MainTab:Section({ Title = "Fire FX Controls" }):Button({
    Title = "🔥 เล่นเอฟเฟกต์ไฟรวมพลัง (Frei)",
    Callback = function()
        if type(FireModule) == "function" then
            FireModule(game.Players.LocalPlayer.Character)
        elseif type(FireModule) == "table" and FireModule.PlayEffect then
            FireModule.PlayEffect(game.Players.LocalPlayer.Character)
        end
    end
})

RaceTab:Section({ Title = "Race Reroll" }):Button({
    Title = "🎲 สุ่มเผ่าใหม่ (Race Module)",
    Callback = function()
        if type(RaceModule) == "function" then
            RaceModule()
        end
    end
})
