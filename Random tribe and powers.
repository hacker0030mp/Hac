-- ฟังก์ชันช่วยดึงและรันโค้ดจาก URL บน GitHub
local function FetchModule(fileName)
    local rawUrl = "https://raw.githubusercontent.com/hacker0030mp/Hac/main/" .. fileName
    local success, result = pcall(function()
        return loadstring(game:HttpGet(rawUrl))()
    end)
    
    if success then
        print("[Minh Kha Hub] Successfully loaded module: " .. fileName)
        return result
    else
        warn("[Minh Kha Hub] Failed to load module: " .. fileName .. " | Error: " .. tostring(result))
        return nil
    end
end

