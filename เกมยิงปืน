-- [แท็บ 2] เทเลพอร์ต (Teleport to Enemy)
-- ==========================================================
Tab2:Button({
    Title = "เทเลพอร์ตไปหาศัตรูที่ใกล้ที่สุด",
    Callback = function()
        local closestTarget = nil
        local shortestDist = math.huge
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if myRoot then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if not teamCheckEnabled or p.Team ~= LocalPlayer.Team then
                        local dist = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = p.Character.HumanoidRootPart
                        end
                    end
                end
            end
            if closestTarget then
                myRoot.CFrame = closestTarget.CFrame + Vector3.new(0, 3, 0)
                WindUI:Notify({ Title = "Teleport", Content = "วาร์ปไปหาศัตรูสำเร็จ!", Duration = 2 })
            else
                WindUI:Notify({ Title = "Teleport", Content = "ไม่พบเป้าหมายในระยะ!", Duration = 2 })
            end
        end
    end
})

