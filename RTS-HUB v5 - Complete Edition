-- 🎮 ระบบล็อคเป้า (AimLock)
local AimSection = TabSettings:Section({ Title = "🎮 ล็อคเป้าอัจฉริยะ", Box = true })
local AimSettings = {
    Enabled = ConfigData.AimLockEnabled,
    FOV = ConfigData.FOV,
    TeamCheck = ConfigData.TeamCheck
}

local function getClosestTarget()
    local target, minDist = nil, AimSettings.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health>0 then
                if AimSettings.TeamCheck and p.Team==LocalPlayer.Team then continue end
                local sp, onScr = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if onScr then
                    local d = (Vector2.new(sp.X, sp.Y)-center).Magnitude
                    if d<minDist then minDist=d; target=p.Character.HumanoidRootPart end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if AimSettings.Enabled then
        local t = getClosestTarget()
        if t then Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position) end
    end
end)

