local TabESP = Window:Tab({ Title = "ESP มองทะลุ", Icon = "eye" })
local ESPSect = TabESP:Section({ Title = "ตั้งค่า ESP", Box = true, BoxBorder = true, Opened = true })

local ESPState = { Enabled = ConfigData.ESPEnabled, Box = true, Tracer = true, Name = true, Dist = true }
local ESPDraws = {}

local function ClearESP(p)
    if ESPDraws[p] then
        pcall(function()
            for _, o in pairs(ESPDraws[p]) do
                if o and typeof(o.Remove) == "function" then o:Remove() end
            end
        end)
        ESPDraws[p] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not ESPState.Enabled then
        for p in pairs(ESPDraws) do ClearESP(p) end
        return
    end

    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local c = p.Character
                local hrp = c:FindFirstChild("HumanoidRootPart")
                local hum = c:FindFirstChild("Humanoid")
                if not hrp or not hum or hum.Health <= 0 then
                    ClearESP(p)
                    continue
                end

                if not ESPDraws[p] and Drawing then
                    ESPDraws[p] = {
                        Box = Drawing.new("Square"),
                        Line = Drawing.new("Line"),
                        Text = Drawing.new("Text")
                    }
                    ESPDraws[p].Box.Thickness = 1.5; ESPDraws[p].Box.Filled = false; ESPDraws[p].Box.Color = Color3.fromRGB(0, 145, 255)
                    ESPDraws[p].Line.Thickness = 1; ESPDraws[p].Line.Color = Color3.fromRGB(0, 145, 255)
                    ESPDraws[p].Text.Size = 14; ESPDraws[p].Text.Center = true; ESPDraws[p].Text.Outline = true; ESPDraws[p].Text.Color = Color3.new(1, 1, 1)
                end

                local draws = ESPDraws[p]
                if draws then
                    local v, onScr = Camera:WorldToViewportPoint(hrp.Position)
                    local d = (Camera.CFrame.Position - hrp.Position).Magnitude
                    local head = c:FindFirstChild("Head")
                    local tV = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or v
                    local bV = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local h = math.abs(tV.Y - bV.Y)
                    local w = h / 2

                    draws.Box.Visible = onScr and ESPState.Box
                    draws.Line.Visible = onScr and ESPState.Tracer
                    draws.Text.Visible = onScr and ESPState.Name

                    if onScr then
                        if ESPState.Box then
                            draws.Box.Size = Vector2.new(w, h)
                            draws.Box.Position = Vector2.new(v.X - w / 2, tV.Y)
                        end
                        if ESPState.Tracer then
                            local vp = Camera.ViewportSize
                            draws.Line.From = Vector2.new(vp.X / 2, vp.Y)
                            draws.Line.To = Vector2.new(v.X, bV.Y)
                        end
                        if ESPState.Name then
                            draws.Text.Text = p.Name .. (ESPState.Dist and (" [" .. math.floor(d) .. "m]") or "")
                            draws.Text.Position = Vector2.new(v.X, tV.Y - 18)
                        end
                    end
                end
            else
                ClearESP(p)
            end
        end
    end)
end)

