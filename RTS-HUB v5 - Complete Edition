local SaveFileName = "RTS_HUB_v5_Config.json"
local ConfigData = {
    AutoSaveEnabled = true,
    FOV = 150,
    TeamCheck = true,
    CrosshairColor = {255, 255, 255},
    CrosshairEnabled = false,
    AimLockEnabled = false,
    ESPEnabled = false,
    AntiAFKEnabled = false,
    WalkSpeed = 16,
    FullbrightEnabled = false
}

local function LoadConfig()
    if isfile and isfile(SaveFileName) then
        local ok, result = pcall(function() return HttpService:JSONDecode(readfile(SaveFileName)) end)
        if ok and type(result) == "table" then
            for k, v in pairs(result) do ConfigData[k] = v end
            print("[RTS-HUB v5] ✅ โหลดค่าตั้งค่าสำเร็จ")
        end
    end
end

local function SaveConfig()
    if writefile then
        local ok = pcall(function() writefile(SaveFileName, HttpService:JSONEncode(ConfigData)) end)
        if ok then print("[RTS-HUB v5] 💾 บันทึกค่าตั้งค่าสำเร็จ") end
    end
end

