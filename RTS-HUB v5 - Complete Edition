-- 🎯 เป้าเล็งหมุนได้ (Dynamic Crosshair)
local CrosshairSection = TabSettings:Section({ Title = "🎯 เป้าเล็ง", Box = true })
local CrosshairSettings = {
    Enabled = ConfigData.CrosshairEnabled,
    Color = Color3.fromRGB(unpack(ConfigData.CrosshairColor)),
    Radius = 45, Size = 12, Thickness = 2, RotationSpeed = 3
}

local crosshairLines = {}
for i = 1, 4 do
    local l = Drawing.new("Line")
    l.Visible = false; l.Color = CrosshairSettings.Color
    l.Thickness = 2; l.Transparency = 1
    table.insert(crosshairLines, l)
end
local crosshairCircle = Drawing.new("Circle")
crosshairCircle.Visible = false
crosshairCircle.Color = CrosshairSettings.Color
crosshairCircle.Thickness = 1.5; crosshairCircle.NumSides = 32
crosshairCircle.Radius = 45; crosshairCircle.Filled = false; crosshairCircle.Transparency = 1

local crossAngle = 0
RunService.RenderStepped:Connect(function(dt)
    if not CrosshairSettings.Enabled then
        for _, l in ipairs(crosshairLines) do l.Visible = false end
        crosshairCircle.Visible = false
        return
    end
    local c = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    crossAngle += 3*dt
    crosshairCircle.Visible = true
    crosshairCircle.Position = c
    for i = 1, 4 do
        local a = crossAngle + ((i-1)*math.pi/2)
        local p1 = Vector2.new(c.X+math.cos(a)*4, c.Y+math.sin(a)*4)
        local p2 = Vector2.new(c.X+math.cos(a)*16, c.Y+math.sin(a)*16)
        crosshairLines[i].Visible = true
        crosshairLines[i].From = p1
        crosshairLines[i].To = p2
    end
end)

