local SaveFileName = "rts_hub_config_v55.json"
local ConfigData = {
    AutoSaveEnabled = true,
    FOV = 150,
    TeamCheck = true,
    CrosshairColor = {255, 255, 255},
    CrosshairEnabled = false,
    ESPEnabled = false,
    WalkSpeed = 16,
    FullbrightEnabled = false,
    AntiAFKEnabled = false
}

local function LoadConfig()
    pcall(function()
        if pcall(function() return isfile and isfile(SaveFileName) end) and isfile(SaveFileName) then
            local successLoad, result = pcall(function() return HttpService:JSONDecode(readfile(SaveFileName)) end)
            if successLoad and type(result) == "table" then
                for k, v in pairs(result) do ConfigData[k] = v end
            end
        end
    end)
end

local function SaveConfig()
    pcall(function()
        if writefile then
            pcall(function() writefile(SaveFileName, HttpService:JSONEncode(ConfigData)) end)
        end
    end)
end

LoadConfig()

