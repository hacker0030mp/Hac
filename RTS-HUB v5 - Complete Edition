-- 👁️ แท็บที่ 3: ESP มองทะลุ (ESP Suite)
-- =========================================================================
local TabESP = Window:Tab({ Title = "ESP มองทะลุ", Icon = "eye" })
local ESPSect = TabESP:Section({ Title = "ตั้งค่า ESP รายละเอียดสูง", Box = true, BoxBorder = true, Opened = true })

local ESPState = { Enabled = ConfigData.ESPEnabled, Box = true, Tracer = true, Name = true, Dist = true }
local ESPDraws = {}

local function ClearESP(p)
    if ESPDraws[p] then for _, o in pairs(ESPDraws[p]) do pcall(function() o:Remove() end) end; ESPDraws[p]=nil end
end

RunService.RenderStepped:Connect(function()
    if not ESPState.Enabled then for p in pairs(ESPDraws) do ClearESP(p) end return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local c = p.Character
            local hrp = c.HumanoidRootPart
            local hum = c:FindFirstChild("Humanoid")
            if not hum or hum.Health<=0 then ClearESP(p) goto continue end
            
            if not ESPDraws[p] then
                ESPDraws[p] = {
                    Box = Drawing.new("Square"),
                    Line = Drawing.new("Line"),
                    Text = Drawing.new("Text")
                }
                ESPDraws[p].Box.Thickness=1.5; ESPDraws[p].Box.Filled=false; ESPDraws[p].Box.Color=Color3.fromRGB(138,43,226)
                ESPDraws[p].Line.Thickness=1; ESPDraws[p].Line.Color=Color3.fromRGB(138,43,226)
                ESPDraws[p].Text.Size=14; ESPDraws[p].Text.Center=true; ESPDraws[p].Text.Outline=true; ESPDraws[p].Text.Color=Color3.new(1,1,1)
            end
            
            local v, onScr = Camera:WorldToViewportPoint(hrp.Position)
            local d = (Camera.CFrame.Position-hrp.Position).Magnitude
            local head = c:FindFirstChild("Head")
            local tV = head and Camera:WorldToViewportPoint(head.Position+Vector3.new(0,.5,0)) or v
            local bV = Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
            local h = math.abs(tV.Y-bV.Y)
            local w = h/2
            
            ESPDraws[p].Box.Visible = onScr and ESPState.Box
            ESPDraws[p].Line.Visible = onScr and ESPState.Tracer
            ESPDraws[p].Text.Visible = onScr and ESPState.Name
            
            if onScr then
                if ESPState.Box then ESPDraws[p].Box.Size=Vector2.new(w,h); ESPDraws[p].Box.Position=Vector2.new(v.X-w/2,tV.Y) end
                if ESPState.Tracer then ESPDraws[p].Line.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y); ESPDraws[p].Line.To=Vector2.new(v.X,bV.Y) end
                if ESPState.Name then ESPDraws[p].Text.Text=p.Name..(ESPState.Dist and (" ["..math.floor(d).."m]") or ""); ESPDraws[p].Text.Position=Vector2.new(v.X,tV.Y-18) end
            end
            ::continue::
        else ClearESP(p) end
    end
end)

