-- 🎮 ล็อคเป้าอัจฉริยะ (AimLock)
local AimSection = TabSettings:Section({ Title = "🎮 ล็อคเป้าอัจฉริยะ", Box = true })
local AimSettings = { Enabled = false, FOV = ConfigData.FOV, TeamCheck = ConfigData.TeamCheck }

local function getClosestTarget()
    local target, minDist = nil, AimSettings.FOV
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if AimSettings.TeamCheck and p.Team == LocalPlayer.Team then continue end
                local sp, onScr = Camera:WorldToViewportPoint(hrp.Position)
                if onScr then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < minDist then
                        minDist = d
                        target = hrp
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if AimSettings.Enabled then
        local t = getClosestTarget()
        if t then Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position) end
    end
end)

