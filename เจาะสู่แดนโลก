local TabESP = Window:Tab({ Title = "4. ระบบ ESP มองทะลุ", Icon = "eye" })

local ESPSection = TabESP:Section({
    Title = "ตั้งค่าการแสดงผล ESP",
    Box = true, BoxBorder = true, Opened = true
})

local isESPActive = false
local espShowBox = true
local espShowTracer = true
local espShowName = true
local espShowDistance = true

ESPSection:Toggle({
    Title = "เปิด/ปิด ระบบ ESP ทั้งหมด",
    Value = false,
    Callback = function(state)
        isESPActive = state
        WindUI:Notify({ Title = "ESP System", Content = state and "เปิดระบบ ESP แล้ว" or "ปิดระบบ ESP แล้ว", Duration = 2 })
    end
})

ESPSection:Toggle({ Title = "แสดงกรอบสี่เหลี่ยม (Box ESP)", Value = true, Callback = function(state) espShowBox = state end })
ESPSection:Toggle({ Title = "แสดงเส้นโยง (Tracer Line)", Value = true, Callback = function(state) espShowTracer = state end })
ESPSection:Toggle({ Title = "แสดงชื่อและระยะทาง", Value = true, Callback = function(state) espShowName = state; espShowDistance = state end })

local espDrawings = {}
local function removeESP(player)
    if espDrawings[player] then
        for _, obj in pairs(espDrawings[player]) do
            pcall(function() obj:Remove() end)
        end
        espDrawings[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if isESPActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local character = player.Character
                local hrp = character.HumanoidRootPart
                
                if not espDrawings[player] then
                    espDrawings[player] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line"),
                        Info = Drawing.new("Text")
                    }
                    espDrawings[player].Box.Filled = false
                    espDrawings[player].Box.Thickness = 1.5
                    espDrawings[player].Box.Color = Color3.fromRGB(138, 43, 226)
                    espDrawings[player].Tracer.Thickness = 1
                    espDrawings[player].Tracer.Color = Color3.fromRGB(138, 43, 226)
                    espDrawings[player].Info.Size = 14
                    espDrawings[player].Info.Center = true
                    espDrawings[player].Info.Outline = true
                    espDrawings[player].Info.Color = Color3.fromRGB(255, 255, 255)
                end

                local visuals = espDrawings[player]
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    local head = character:FindFirstChild("Head")
                    local topVector = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                    local bottomVector = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(topVector.Y - bottomVector.Y)
                    local width = height / 2

                    if espShowBox then
                        visuals.Box.Visible = true
                        visuals.Box.Size = Vector2.new(width, height)
                        visuals.Box.Position = Vector2.new(vector.X - width / 2, topVector.Y)
                    else
                        visuals.Box.Visible = false
                    end

                    if espShowTracer then
                        visuals.Tracer.Visible = true
                        visuals.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        visuals.Tracer.To = Vector2.new(vector.X, bottomVector.Y)
                    else
                        visuals.Tracer.Visible = false
                    end

                    if espShowName then
                        visuals.Info.Visible = true
                        local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
                        visuals.Info.Text = player.Name .. " [" .. dist .. "m]"
                        visuals.Info.Position = Vector2.new(vector.X, topVector.Y - 18)
                    else
                        visuals.Info.Visible = false
                    end
                else
                    visuals.Box.Visible = false
                    visuals.Tracer.Visible = false
                    visuals.Info.Visible = false
                end
            else
                removeESP(player)
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player) removeESP(player) end)

