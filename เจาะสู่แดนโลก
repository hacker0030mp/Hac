local isFastAttackActive = false
local attackSpeed = 0.1
local attackRange = 100

CombatSection:Toggle({
    Title = "เปิด/ปิด ออโต้โจมตีรัวๆ (ไม่ตีผู้เล่น)",
    Desc = "ฟัน/โจมตีมอนสเตอร์รัวๆ โดยตัวละครนิ่งอยู่กับที่",
    Value = false,
    Callback = function(state)
