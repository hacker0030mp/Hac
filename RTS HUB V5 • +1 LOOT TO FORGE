LoadEngine()

--============================================================
-- CONFIG HELPER
--============================================================

local function SetConfig(Name, Value)

    if UpdateEngineState() and CONFIG then

        CONFIG[Name] = Value

        return true

    end

    return false
end

--============================================================
-- CALL ENGINE
--============================================================

local function Call(Name, ...)

    local Args = table.pack(...)

    task.spawn(function()

        if not UpdateEngineState() then

            warn(
                "RTS HUB V5:",
                Name,
                "Engine chưa sẵn sàng"
            )

            return
        end

        if not Debug then
            return
        end

        local Function = Debug[Name]

        if type(Function) ~= "function" then

            warn(
                "RTS HUB V5:",
                "Không tìm thấy chức năng:",
                Name
            )

            return
        end

        local ok, err = pcall(function()

            Function(
                table.unpack(
                    Args,
                    1,
                    Args.n
                )
            )

        end)

        if not ok then

            warn(
                "RTS HUB V5:",
                Name,
                err
            )

        end

    end)
end

