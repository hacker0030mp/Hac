local AntiAFK = false
local InfiniteJump = false
local NoClip = false
local Speed = 16

local function SetSpeed(Value)

    Speed = math.clamp(
        math.floor(
            tonumber(Value) or 16
        ),
        1,
        250
    )

    local Character =
        Player.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then
        Humanoid.WalkSpeed = Speed
    end
end

