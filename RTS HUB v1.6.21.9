local ZiplockActive, IsLockedOn, AimFOV = false, false, 150

ZiplockBtn.MouseButton1Down:Connect(function()
    if ZiplockActive then
        IsLockedOn = not IsLockedOn
        ZiplockBtn.BackgroundColor3 = IsLockedOn and Color3.fromRGB(124, 58, 237) or Color3.fromRGB(15, 23, 42)
        ZiplockBtn.TextColor3 = IsLockedOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(139, 92, 246)
    end
end)

local function getClosestTarget()
    local target, minDist = nil, AimFOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local sp, onScr = Camera:WorldToViewportPoint(hrp.Position)
                if onScr then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < minDist then minDist = d; target = hrp end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if ZiplockActive and IsLockedOn then
        pcall(function()
            local t = getClosestTarget()
            if t then Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position) end
        end)
    end
end)

