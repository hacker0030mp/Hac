-- อัปเกรด & เกิดใหม่ (Rebirth)
--------------------------------------------------------------------------------

local function doUpgrades()
	if not CONFIG.upgrade then return end
	local upgRem = wfc(wfc(Remote, "Upgrade"), "UpgradeRE")
	if not upgRem then return end

	local list = {}
	if CONFIG.upgOrePack then list[#list + 1] = "OrePack" end
	if CONFIG.upgTrain then list[#list + 1] = "Train" end
	if CONFIG.upgLuck then list[#list + 1] = "Luck" end

	for _, name in ipairs(list) do
		if STATE.coin > CONFIG.coinKeep then
			pcall(function()
				upgRem:FireServer(name)
			end)
			STATE.upgrades = STATE.upgrades + 1
			task.wait(0.2)
			refresh(true)
		end
	end
end

local function checkRebirth()
	if not CONFIG.rebirth then return end
	if STATE.level >= STATE.needLevel and STATE.needLevel > 0 then
		local ok = pcall(function() R.rebirth:FireServer() end)
		if ok then
			STATE.rebirths = STATE.rebirths + 1
			task.wait(1)
			refresh(true)
		end
	end
end

