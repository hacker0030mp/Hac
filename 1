-- ลูปการทำงานหลัก (Main Loop)
--------------------------------------------------------------------------------

task.spawn(function()
	while GEN == _G.__LOOTTOFORGE do
		if CONFIG.auto then
			pcall(function()
				refresh(true)
				checkRebirth()
				doUpgrades()

				local d = data()
				if d then
					doEquipAndSell(d)
					if STATE.ore >= 4 then
						doForge()
					end
				end

				if CONFIG.farm then
					stageRun()
				end

				if CONFIG.train then
					trainPass(CONFIG.trainSecs)
				end
			end)
		end
		task.wait(1)
	end
end)

